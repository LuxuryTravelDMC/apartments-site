---
// Isometric line drawing of the whole apartment on pine. One room at a time is
// highlighted (bedroom, living room, kitchen, bathroom) and the tabs follow. It switches every
// 5 seconds by itself, or, with sync, together with the rotating review card
// (which sends a "collage:tick" event). Drawn from the owner's floor plan in
// Figma (frame "Phoenix Apartment"); regenerate with scripts/blueprint.py.
interface Props { name?: string; size?: string; sync?: boolean }
const { name = 'Phoenix Apartment', size = '40', sync = false } = Astro.props;
const tabs = ['Υπνοδωμάτιο', 'Σαλόνι', 'Κουζίνα', 'Μπάνιο'];
