 d="M298.5 237.2 L262.5 258.0 L262.5 246.8 L298.5 226.0 Z"/><path class="bp__fill" d="M255.6 254.0 L262.5 258.0 L262.5 246.8 L255.6 242.8 Z"/><path class="bp__fill" d="M291.6 222.0 L298.5 226.0 L262.5 246.8 L255.6 242.8 Z"/></g></svg>
