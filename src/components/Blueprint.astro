<div class="bp" data-bp data-sync={sync ? 'true' : undefined} data-active="0">
  <div class="bp__tabs">{tabs.map((t, i) => <button type="button" class="bp__tab" data-tab={i}>/{t}</button>)}</div>
  <svg viewBox="-144 -67 386 295" class="bp__svg" aria-hidden="true"><path class="bp__zone" data-zone="0" d="M94.6 80.0 L209.4 146.3 L129.0 192.7 L14.1 126.4 Z"/><path class="bp__zone" data-zone="1" d="M-80.4 71.8 L47.5 145.7 L-19.2 184.1 L-52.5 164.9 L-17.5 144.7 L-112.1 90.1 Z"/><path class="bp__zone" data-zone="2" d="M0.0 25.4 L94.6 80.0 L14.1 126.4 L-80.4 71.8 Z"/><path class="bp__zone" data-zone="3" d="M47.5 145.7 L129.0 192.7 L84.5 218.4 L3.0 171.3 Z"/><g class="bp__shell"><path class="bp__balc" d="M0.0 0.0 L231.4 133.6 L209.4 146.3 L0.0 25.4 L-112.1 90.1 L-134.1 77.4 Z"/><path class="bp__grid" d="M8.1 4.7 L-13.9 17.3 Z"/><path class="bp__grid" d="M16.3 9.4 L-5.7 22.1 Z"/><path class="bp__grid" d="M24.4 14.1 L2.5 26.8 Z"/><path class="bp__grid" d="M32.6 18.8 L10.6 31.5 Z"/><path class="bp__grid" d="M40.8 23.6 L18.8 36.2 Z"/><path class="bp__grid" d="M49.0 28.3 L27.0 41.0 Z"/><path class="bp__grid" d="M57.2 33.0 L35.2 45.7 Z"/><path class="bp__grid" d="M65.4 37.7 L43.4 50.4 Z"/><path class="bp__grid" d="M73.5 42.5 L51.6 55.1 Z"/><path class="bp__grid" d="M81.7 47.2 L59.7 59.9 Z"/><path class="bp__grid" d="M89.9 51.9 L67.9 64.6 Z"/><path class="bp__grid" d="M98.1 56.6 L76.1 69.3 Z"/><path class="bp__grid" d="M106.3 61.4 L84.3 74.0 Z"/><path class="bp__grid" d="M114.5 66.1 L92.5 78.8 Z"/><path class="bp__grid" d="M122.6 70.8 L100.7 83.5 Z"/><path class="bp__grid" d="M130.8 75.5 L108.8 88.2 Z"/><path class="bp__grid" d="M139.0 80.3 L117.0 92.9 Z"/><path class="bp__grid" d="M147.2 85.0 L125.2 97.7 Z"/><path class="bp__grid" d="M155.4 89.7 L133.4 102.4 Z"/><path class="bp__grid" d="M163.6 94.4 L141.6 107.1 Z"/><path class="bp__grid" d="M171.7 99.2 L149.8 111.8 Z"/><path class="bp__grid" d="M179.9 103.9 L158.0 116.6 Z"/><path class="bp__grid" d="M188.1 108.6 L166.1 121.3 Z"/><path class="bp__grid" d="M196.3 113.3 L174.3 126.0 Z"/><path class="bp__grid" d="M204.5 118.1 L182.5 130.7 Z"/><path class="bp__grid" d="M212.7 122.8 L190.7 135.5 Z"/><path class="bp__grid" d="M