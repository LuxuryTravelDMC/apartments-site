---
// Isometric line drawing of the whole apartment on pine. One room at a time is
// highlighted (bedroom, then living room) and the tabs follow. It switches every
// 5 seconds by itself, or, with sync, together with the rotating review card
// (which sends a "collage:tick" event). An illustration, not an exact plan.
interface Props { name?: string; size?: string; sync?: boolean }
const { name = 'Phoenix Apartment', size = '40', sync = false } = Astro.props;
const tabs = ['Υπνοδωμάτιο', 'Σαλόνι'];
---
<div class="bp" data-bp data-sync={sync ? 'true' : undefined} data-active="0">
  <div class="bp__tabs">{tabs.map((t, i) => <button type="button" class="bp__tab" data-tab={i}>/{t}</button>)}</div>
  <svg viewBox="0 0 400 300" class="bp__svg" aria-hidden="true"><path class="bp__zone" data-zone="0" d="M196.0 86.0 L279.8 134.4 L144.9 212.3 L61.1 163.9 Z"/><path class="bp__zone" data-zone="1" d="M279.8 134.4 L387.7 196.7 L252.8 274.6 L144.9 212.3 Z"/><g class="bp__shell"><path class="bp__grid" d="M210.2 94.2 L75.3 172.1 M224.4 102.4 L89.5 180.3 M238.6 110.6 L103.7 188.5 M252.8 118.8 L117.9 196.7 M267.0 127.0 L132.1 204.9 M281.2 135.2 L146.3 213.1 M295.4 143.4 L160.5 221.3 M309.6 151.6 L174.7 229.5 M323.8 159.8 L188.9 237.7 M338.0 168.0 L203.1 245.9 M352.2 176.2 L217.3 254.1 M366.4 184.4 L231.5 262.3 M380.6 192.6 L245.7 270.5"/><path d="M196.0 86.0 L387.7 196.7 L252.8 274.6 L61.1 163.9 Z"/><path d="M196.0 86.0 L61.1 163.9 L61.1 90.1 L196.0 12.2 Z"/><path d="M196.0 86.0 L387.7 196.7 L387.7 122.9 L196.0 12.2 Z"/><path class="bp__fill" d="M279.8 134.4 L196.0 182.8 L196.0 109.0 L279.8 60.6 Z"/></g><g class="bp__z" data-zone="0"><path d="M105.1 138.5 L75.3 155.7 L75.3 95.0 L105.1 77.8 Z"/><path class="bp__fill" d="M259.9 127.8 L254.2 131.1 L254.2 103.2 L259.9 99.9 Z"/><path class="bp__fill" d="M194.6 96.7 L254.2 131.1 L254.2 103.2 L194.6 68.8 Z"/><path class="bp__fill" d="M200.3 65.5 L259.9 99.9 L254.2 103.2 L194.6 68.8 Z"/><path class="bp__fill" d="M254.2 131.1 L188.9 168.8 L188.9 156.5 L254.2 118.8 Z"/><path class="bp__fill" d="M129.2 134.4 L188.9 168.8 L188.9 156.5 L129.2 122.1 Z"/><path class="bp__fill" d="M194.6 84.4 L254.2 118.8 L188.9 156.5 L129.2 122.1 Z"/><path class="bp__fill" d="M220.1 114.7 L207.4 122.1 L207.4 104.9 L220.1 97.5 Z"/><path class="bp__fill" d="M184.6 109.0 L207.4 122.1 L207.4 104.9 L184.6 91.7 Z"/><path class="bp__fill" d="M197.4 84.4 L220.1 97.5 L207.4 104.9 L184.6 91.7 Z"/><path class="bp__fill" d="M247.1 130.3 L234.3 137.7 L234.3 120.4 L247.1 113.1 Z"/><path class="bp__fill" d="M211.6 124.5 L234.3 137.7 L234.3 120.4 L211.6 107.3 Z"/><path class="bp__fill" d="M224.4 99.9 L247.1 113.1 L234.3 120.4 L211.6 107.3 Z"/><path class="bp__fill" d="M272.7 135.2 L262.8 140.9 L262.8 126.2 L272.7 120.4 Z"/><path class="bp__fill" d="M252.8 135.2 L262.8 140.9 L262.8 126.2 L252.8 120.4 Z"/><path class="bp__fill" d="M262.8 114.7 L272.7 120.4 L262.8 126.2 L252.8 120.4 Z"/></g><g class="bp__z" data-zone="1"><path d="M316.7 122.9 L366.4 151.6 L366.4 120.4 L316.7 91.7 Z"/><path class="bp__fill" d="M369.3 191.0 L362.2 195.1 L362.2 170.5 L369.3 166.4 Z"/><path class="bp__fill" d="M291.2 154.1 L362.2 195.1 L362.2 170.5 L291.2 129.5 Z"/><path class="bp__fill" d="M298.3 125.4 L369.3 166.4 L362.2 170.5 L291.2 129.5 Z"/><path class="bp__fill" d="M362.2 195.1 L345.1 204.9 L345.1 193.4 L362.2 183.6 Z"/><path class="bp__fill" d="M274.1 163.9 L345.1 204.9 L345.1 193.4 L274.1 152.4 Z"/><path class="bp__fill" d="M291.2 142.6 L362.2 183.6 L345.1 193.4 L274.1 152.4 Z"/><path class="bp__fill" d="M299.7 159.0 L282.6 168.8 L282.6 150.8 L299.7 140.9 Z"/><path class="bp__fill" d="M274.1 163.9 L282.6 168.8 L282.6 150.8 L274.1 145.9 Z"/><path class="bp__fill" d="M291.2 136.0 L299.7 140.9 L282.6 150.8 L274.1 145.9 Z"/><path class="bp__fill" d="M362.2 195.1 L345.1 204.9 L345.1 186.9 L362.2 177.0 Z"/><path class="bp__fill" d="M336.6 200.0 L345.1 204.9 L345.1 186.9 L336.6 181.9 Z"/><path class="bp__fill" d="M353.7 172.1 L362.2 177.0 L345.1 186.9 L336.6 181.9 Z"/><path class="bp__fill" d="M313.9 201.6 L295.4 212.3 L295.4 204.1 L313.9 193.4 Z"/><path class="bp__fill" d="M262.8 193.4 L295.4 212.3 L295.4 204.1 L262.8 185.2 Z"/><path class="bp__fill" d="M281.2 174.6 L313.9 193.4 L295.4 204.1 L262.8 185.2 Z"/><path class="bp__fill" d="M277.0 221.3 L267.0 227.0 L267.0 216.4 L277.0 210.6 Z"/><path class="bp__fill" d="M257.1 221.3 L267.0 227.0 L267.0 216.4 L257.1 210.6 Z"/><path class="bp__fill" d="M267.0 204.9 L277.0 210.6 L267.0 216.4 L257.1 210.6 Z"/><path class="bp__fill" d="M234.3 221.3 L224.4 227.0 L224.4 216.4 L234.3 210.6 Z"/><path class="bp__fill" d="M214.5 221.3 L224.4 227.0 L224.4 216.4 L214.5 210.6 Z"/><path class="bp__fill" d="M224.4 204.9 L234.3 210.6 L224.4 216.4 L214.5 210.6 Z"/><path d="M245.7 215.6 L245.7 233.6"/><path class="bp__fill" d="M259.9 223.8 L257.5 224.9 L254.8 225.9 L251.9 226.6 L248.9 227.0 L245.7 227.2 L242.6 227.0 L239.5 226.6 L236.6 225.9 L233.9 224.9 L231.5 223.8 L229.5 222.4 L227.8 220.8 L226.6 219.1 L225.9 217.4 L225.6 215.6 L225.9 213.7 L226.6 212.0 L227.8 210.3 L229.5 208.7 L231.5 207.4 L233.9 206.2 L236.6 205.2 L239.5 204.5 L242.6 204.1 L245.7 204.0 L248.9 204.1 L251.9 204.5 L254.8 205.2 L257.5 206.2 L259.9 207.4 L262.0 208.7 L263.6 210.3 L264.8 212.0 L265.5 213.7 L265.8 215.6 L265.5 217.4 L264.8 219.1 L263.6 220.8 L262.0 222.4 Z"/><path class="bp__fill" d="M277.0 245.9 L267.0 251.6 L267.0 241.0 L277.0 235.2 Z"/><path class="bp__fill" d="M257.1 245.9 L267.0 251.6 L267.0 241.0 L257.1 235.2 Z"/><path class="bp__fill" d="M267.0 229.5 L277.0 235.2 L267.0 241.0 L257.1 235.2 Z"/><path class="bp__fill" d="M234.3 245.9 L224.4 251.6 L224.4 241.0 L234.3 235.2 Z"/><path class="bp__fill" d="M214.5 245.9 L224.4 251.6 L224.4 241.0 L214.5 235.2 Z"/><path class="bp__fill" d="M224.4 229.5 L234.3 235.2 L224.4 241.0 L214.5 235.2 Z"/></g></svg>
  <div class="bp__foot"><span>{name}</span><span>{size} τ.μ.</span></div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-bp]').forEach((bp) => {
    const n = 2;
    const show = (i: number) => (bp.dataset.active = String(((i % n) + n) % n));
    bp.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.tab))));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (bp.dataset.sync) {
      document.addEventListener('collage:tick', () => show(Number(bp.dataset.active) + 1));
    } else {
      let hold = false;
      bp.addEventListener('mouseenter', () => (hold = true));
      bp.addEventListener('mouseleave', () => (hold = false));
      setInterval(() => !hold && show(Number(bp.dataset.active) + 1), 5000);
    }
  });
</script>
<style>
  .bp { background: var(--pine) url('/paper.svg'); color: var(--white); border-radius: 6px; padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; }
  .bp__tabs { display: flex; gap: 14px; }
  .bp__tab { background: none; border: 0; padding: 4px 0; color: var(--white); font: 500 14px var(--sans); opacity: .5; cursor: pointer; transition: opacity .4s; }
  .bp[data-active='0'] [data-tab='0'], .bp[data-active='1'] [data-tab='1'] { opacity: 1; }
  .bp__svg { width: 100%; height: auto; display: block; }
  .bp__svg path { fill: none; stroke: #fff; stroke-width: 1.2; stroke-linejoin: round; }
  .bp__svg .bp__fill { fill: var(--pine); }
  .bp__svg .bp__grid { stroke: rgb(255 255 255 / .16); stroke-width: 1; }
  .bp__shell { opacity: .9; }
  .bp__z { opacity: .32; transition: opacity .5s; }
  .bp__z path { transition: stroke-width .5s; }
  .bp__svg .bp__zone { fill: rgb(233 169 47 / .0); stroke: none; transition: fill .5s; }
  .bp[data-active='0'] .bp__z[data-zone='0'], .bp[data-active='1'] .bp__z[data-zone='1'] { opacity: 1; }
  .bp[data-active='0'] .bp__z[data-zone='0'] path, .bp[data-active='1'] .bp__z[data-zone='1'] path { stroke-width: 1.7; }
  .bp[data-active='0'] .bp__zone[data-zone='0'], .bp[data-active='1'] .bp__zone[data-zone='1'] { fill: rgb(233 169 47 / .28); }
  .bp__foot { display: flex; justify-content: space-between; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; opacity: .8; border-top: 1px solid rgb(255 255 255 / .3); padding-top: 8px; }
  @media (prefers-reduced-motion: reduce) { .bp__z, .bp__zone, .bp__tab { transition: none; } }
</style>
