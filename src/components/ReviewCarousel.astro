---
// Guest reviews as a looping carousel: three cards in view, the middle one
// bigger. Moves by itself every few seconds (stops on hover, on focus and for
// "reduce motion" users) and has arrows and dots. Works with any number of
// reviews; with more than three, the rest wait off-stage.
import { reviews } from '../data/stays';
const list = reviews.filter((r) => !r.text.startsWith('['));
---
<div class="rc" data-rc aria-roledescription="carousel" aria-label="Κριτικές επισκεπτών">
  <div class="rc__stage">
    {list.map((r, i) => (
      <figure class="rc__card" data-i={i} aria-roledescription="slide" aria-label={`${i + 1} από ${list.length}`}>
        <div class="rc__stars" aria-hidden="true">★★★★★</div>
        <blockquote>{r.text}</blockquote>
        <figcaption>{r.who} · {r.stay}</figcaption>
      </figure>
    ))}
  </div>
  <div class="rc__nav">
    <button type="button" class="rc__btn" data-prev aria-label="Προηγούμενη κριτική">←</button>
    <div class="rc__dots">{list.map((_, i) => <button type="button" class="rc__dot" data-dot={i} aria-label={`Κριτική ${i + 1}`}></button>)}</div>
    <button type="button" class="rc__btn" data-next aria-label="Επόμενη κριτική">→</button>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-rc]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('.rc__card')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.rc__dot')];
    const n = cards.length;
    if (!n) return;
    let cur = 0, timer: number | undefined, paused = false;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const render = () => {
      cards.forEach((c, i) => {
        let off = (i - cur + n) % n;          // 0 = centre
        if (off > n / 2) off -= n;            // negative = left side
        const pos = n === 2 && off === 1 ? 1 : off;
        c.dataset.pos = Math.abs(pos) <= 1 ? String(pos) : (pos < 0 ? 'out-l' : 'out-r');
        c.setAttribute('aria-hidden', pos === 0 ? 'false' : 'true');
      });
      dots.forEach((d, i) => d.setAttribute('aria-current', i === cur ? 'true' : 'false'));
    };
    const go = (to: number) => { cur = (to + n) % n; render(); };
    const start = () => { if (reduce || n < 2) return; stop(); timer = window.setInterval(() => !paused && go(cur + 1), 5000); };
    const stop = () => window.clearInterval(timer);
    root.querySelector('[data-prev]')?.addEventListener('click', () => { go(cur - 1); start(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { go(cur + 1); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { go(i); start(); }));
    cards.forEach((c, i) => c.addEventListener('click', () => { if (i !== cur) { go(i); start(); } }));
    root.addEventListener('mouseenter', () => (paused = true));
    root.addEventListener('mouseleave', () => (paused = false));
    root.addEventListener('focusin', () => (paused = true));
    root.addEventListener('focusout', () => (paused = false));
    // swipe on phones
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) { go(cur + (dx < 0 ? 1 : -1)); start(); }
      x0 = null;
    });
    render();
    start();
  });
</script>
<style>
  .rc { --w: min(380px, 31%); --gap: 24px; overflow: hidden; padding: 24px 0 8px; }
  .rc__stage { display: grid; place-items: center; min-height: 340px; }
  .rc__card { grid-area: 1 / 1; width: var(--w); margin: 0; padding: 28px; background: var(--white); border: 1px solid var(--line); border-radius: 6px;
    transition: transform .6s cubic-bezier(.2,.7,.2,1), opacity .6s, box-shadow .6s; cursor: pointer; }
  .rc__card[data-pos='0'] { transform: translateX(0) scale(1.12); z-index: 2; cursor: default; box-shadow: 0 20px 44px rgb(54 48 43 / .14); }
  .rc__card[data-pos='-1'] { transform: translateX(calc(-100% - var(--gap) - 4%)) scale(.92); opacity: .65; z-index: 1; }
  .rc__card[data-pos='1'] { transform: translateX(calc(100% + var(--gap) + 4%)) scale(.92); opacity: .65; z-index: 1; }
  .rc__card[data-pos='out-l'] { transform: translateX(-220%) scale(.85); opacity: 0; pointer-events: none; }
  .rc__card[data-pos='out-r'] { transform: translateX(220%) scale(.85); opacity: 0; pointer-events: none; }
  .rc__stars { color: var(--coral); letter-spacing: 2px; }
  .rc blockquote { margin: 12px 0; font: 19px/1.45 var(--serif); }
  .rc figcaption { font-size: 14px; color: var(--ink-2); }
  .rc__nav { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 28px; }
  .rc__btn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--gray-warm); background: var(--white); color: var(--ink); font-size: 18px; cursor: pointer; }
  .rc__btn:hover { border-color: var(--pine); color: var(--pine); }
  .rc__dots { display: flex; gap: 4px; }
  .rc__dot { width: 24px; height: 24px; border: 0; background: none; cursor: pointer; position: relative; }
  .rc__dot::after { content: ''; position: absolute; inset: 8px; border-radius: 50%; background: var(--line); transition: background .3s; }
  .rc__dot[aria-current='true']::after { background: var(--pine); }
  @media (max-width: 760px) {
    .rc { --w: 78%; --gap: 12px; }
    .rc__card[data-pos='0'] { transform: scale(1); }
    .rc__card { padding: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .rc__card { transition: none; } }
</style>
