---
import { site } from '../data/site';
import EagleMark from './EagleMark.astro';
import { stays } from '../data/stays';
---
<footer id="contact" class="foot">
  <div class="wrap foot__grid">
    <div>
      <div class="foot__logo"><EagleMark size={36} /><span data-brand>{site.name}</span></div>
      <p class="foot__soft">{stays.map((s) => s.place).join(' · ')}</p>
    </div>
    <div>
      <div class="foot__h"><a href="/contact">Επικοινωνία</a></div>
      <div><a href={`mailto:${site.email}`}>{site.email}</a></div>
      <div>{site.phoneHref ? <a href={site.phoneHref}>{site.phoneDisplay}</a> : site.phoneDisplay}</div>
    </div>
    <div>
      <div class="foot__h">Καταλύματα</div>
      {stays.map((s) => <div><a href={`/${s.slug}`}>{s.place}</a></div>)}
    </div>
    <div>
      <div class="foot__h">Στοιχεία</div>
      {stays.map((s) => <div>ΑΜΑ {s.place}: {s.ama}</div>)}
    </div>
  </div>
  <div class="wrap foot__bottom">© {new Date().getFullYear()} <span data-brand>{site.name}</span></div>
</footer>
<style>
  .foot { background: var(--ink); color: var(--white); margin-top: var(--section); font-size: 15px; }
  .foot a { color: var(--white); }
  .foot a:hover { color: var(--honey); }
  .foot__grid { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); padding-top: 64px; padding-bottom: 32px; }
  .foot__logo { display: flex; align-items: center; gap: 10px;
    font: 700 24px var(--serif); }
  .foot__soft { color: var(--gray-light); margin-top: 8px; }
  .foot__h { font-weight: 700; margin-bottom: 8px; }
  .foot__bottom { border-top: 1px solid var(--ink-2); padding-top: 16px; padding-bottom: 32px; color: var(--gray-light); font-size: 14px; }
</style>
