---
import { factsLine, type Stay } from '../data/stays';
import Photo from './Photo.astro';
interface Props { stay: Stay }
const { stay: s } = Astro.props;
---
<article class:list={['card', `card--${s.theme}`]}>
  <a href={`/${s.slug}`} class="card__photo" tabindex="-1"><Photo name={s.cardPhoto} alt={`${s.title}, ${s.place}`} sizes="(max-width: 760px) 100vw, 620px" /></a>
  <div class="card__body">
    <div class="card__top">
      <span class="label">{s.place} · {s.area}</span>
      {s.isNew && <span class="chip chip--new">Νέο</span>}
    </div>
    <h3><a href={`/${s.slug}`}>{s.title}</a></h3>
    <div class="small card__facts">{factsLine(s.facts, false)}</div>
    <p>{s.short}</p>
    <div class="card__foot">
      <div>από <strong>{s.priceFrom} €</strong> / βράδυ</div>
      <a class:list={['btn', s.theme === 'city' ? 'btn--honey card__btn--city' : 'card__btn--sea']} href={`/${s.slug}`}>Δείτε το διαμέρισμα</a>
    </div>
  </div>
</article>
<style>
  .card { background: var(--white); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; display: flex; flex-direction: column; }
  .card--sea { background: var(--pine-light); }
  .card--sea .label { color: var(--pine-hover); }
  .card__photo { display: block; height: 340px; text-decoration: none; }
  .card__photo > :global(*) { height: 100%; border-radius: 0; }
  .card__body { padding: 32px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .card__top { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .card h3 a { color: var(--ink); text-decoration: none; }
  .card__facts { color: var(--ink-2); }
  .card--sea .card__facts { color: var(--ink); }
  .card__foot { margin-top: auto; padding-top: 8px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .card__btn--city { border-radius: 0; }
  .card__btn--sea { border-radius: 999px; }
  @media (max-width: 700px) { .card__photo { height: 240px; } .card__body { padding: 24px; } }
</style>
