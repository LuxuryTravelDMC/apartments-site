---
// The Black Bird eagle in 3D: each shape sits at its own depth and the whole
// mark tilts with the mouse (or sways gently by itself). Pure CSS + a few
// lines of script, no 3D library. Turns still for "reduce motion" users.
---
<div class="e3d" data-e3d role="img" aria-label="Το σήμα του Black Bird: γεωμετρικός αετός">
  <div class="e3d__rig" data-rig>
    <div class="e3d__l" style="--z:-40px"><svg viewBox="0 0 240 240"><circle cx="120" cy="120" r="112" fill="#E9A92F"/></svg></div>
    <div class="e3d__l" style="--z:-8px"><svg viewBox="0 0 240 240"><path d="M104 128 L26.2 122.6 A78 78 0 0 1 31.7 98.8 Z M104 128 L17.7 85.9 A96 96 0 0 1 32.7 63.8 Z M104 128 L34.5 56.1 A100 100 0 0 1 57.1 39.7 Z M104 128 L70.6 53.1 A82 82 0 0 1 89.8 47.2 Z" fill="#1F1C1A"/>
  <path d="M136 128 L213.8 122.6 A78 78 0 0 0 208.3 98.8 Z M136 128 L222.3 85.9 A96 96 0 0 0 207.3 63.8 Z M136 128 L205.5 56.1 A100 100 0 0 0 182.9 39.7 Z M136 128 L169.4 53.1 A82 82 0 0 0 150.2 47.2 Z" fill="#1F1C1A"/></svg></div>
    <div class="e3d__l" style="--z:6px"><svg viewBox="0 0 240 240"><path d="M104 128 L60 128 A44 44 0 0 1 104 84" fill="none" stroke="#E9A92F" stroke-width="5"/>
  <path d="M136 128 L180 128 A44 44 0 0 0 136 84" fill="none" stroke="#E9A92F" stroke-width="5"/></svg></div>
    <div class="e3d__l" style="--z:12px"><svg viewBox="0 0 240 240"><path d="M120 158 L90 212 L150 212 Z" fill="#1F1C1A"/></svg></div>
    <div class="e3d__l" style="--z:20px"><svg viewBox="0 0 240 240"><path d="M102 176 L102 96 A18 18 0 0 1 138 96 L138 176 Z" fill="#1F1C1A"/></svg></div>
    <div class="e3d__l" style="--z:34px"><svg viewBox="0 0 240 240"><circle cx="122" cy="64" r="18" fill="#1F1C1A"/></svg></div>
    <div class="e3d__l" style="--z:46px"><svg viewBox="0 0 240 240"><path d="M106 58 L86 68 L106 74 Z" fill="#C24F2B"/></svg></div>
    <div class="e3d__l" style="--z:52px"><svg viewBox="0 0 240 240"><circle cx="116" cy="60" r="4" fill="#E9A92F"/></svg></div>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-e3d]').forEach((box) => {
    const rig = box.querySelector<HTMLElement>('[data-rig]')!;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const set = (x: number, y: number) => (rig.style.transform = `rotateX(${y}deg) rotateY(${x}deg)`);
    let follow = false, t = 0;
    window.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      follow = true;
      const r = box.getBoundingClientRect();
      const x = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / 500));
      const y = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / 500));
      set(x * 28, -y * 20);
    }, { passive: true });
    document.addEventListener('pointerleave', () => (follow = false));
    const loop = () => { if (!follow) { t += 0.012; set(Math.sin(t) * 20, Math.cos(t * 0.8) * 8); } requestAnimationFrame(loop); };
    loop();
  });
</script>
<style>
  .e3d { width: 100%; aspect-ratio: 1; perspective: 900px; display: flex; align-items: center; justify-content: center; }
  .e3d__rig { position: relative; width: 82%; height: 82%; transform-style: preserve-3d; transition: transform .15s ease-out; }
  .e3d__l { position: absolute; inset: 0; transform: translateZ(var(--z)); }
  .e3d__l svg { width: 100%; height: 100%; display: block; overflow: visible; }
</style>
