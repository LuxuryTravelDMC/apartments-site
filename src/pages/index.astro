---
import Base from '../layouts/Base.astro';
import BookingBox from '../components/BookingBox.astro';
import Photo from '../components/Photo.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import Eagle3D from '../components/Eagle3D.astro';
import Blueprint from '../components/Blueprint.astro';
import { site } from '../data/site';
import { stays, guides, ratings, reviews } from '../data/stays';
const reviewsFor = (place: string) => reviews.filter((r) => r.short && r.score && r.stay === place);
---
<Base title={`${site.name} · Διαμερίσματα σε Θεσσαλονίκη και Χαλκιδική`}>
  <section class="bighero">
    <div class="bighero__img"><Photo name={site.heroPhoto} alt="" eager sizes="100vw" /></div>
    <div class="wrap bighero__text">
      <div class="label">Θεσσαλονίκη · Χαλκιδική</div>
      <h1 class="hero__title"><span class="hw" data-word="0">Πόλη</span> και <span class="hw" data-word="1">θάλασσα</span>.</h1>
      <p class="hero__lead">Δύο διαμερίσματα, ένα στη Θεσσαλονίκη κι ένα στη Χαλκιδική. Κλείστε απευθείας με τον ιδιοκτήτη.</p>
      <div class="hero__cta"><a class="btn btn--honey" href="#apartments">Τα διαμερίσματά μας</a><a class="hero__link" href="#book">Ελέγξτε διαθεσιμότητα →</a></div>
    </div>
  </section>

  <section class="wrap hero" id="apartments">
    <div class="label">Δύο σπίτια, μία φιλοξενία</div>
    <h2 class="apts__t">Τα διαμερίσματά μας</h2>
    <div class="hs" data-hs data-active="0">
      <div class="hs__tabs" role="tablist" aria-label="Διαλέξτε σπίτι">
        {stays.map((st, i) => (
          <button type="button" role="tab" class:list={['hs__tab', `hs__tab--${st.theme}`]} id={`hs-tab-${i}`} aria-controls={`hs-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} data-hs-tab={i} data-slug={st.slug}>
            <span class="hs__place">{st.place}</span><span class="hs__name">{st.title}</span>
          </button>
        ))}
      </div>
      <div class="collage__eagle"><Eagle3D /></div>
      <div class="hs__stage">
      {stays.map((st, i) => {
        const rs = reviewsFor(st.place);
        const photo = st.photos[0];
        return (
          <div class:list={['collage', `collage--${st.theme}`, !st.size && 'collage--nobp']} role="tabpanel" id={`hs-panel-${i}`} aria-labelledby={`hs-tab-${i}`} data-hs-panel={i}>
            <div class="collage__photo"><Photo name={photo.name} alt={`${st.title}: ${photo.alt}`} eager={i === 0} sizes="(max-width: 900px) 100vw, 760px" /></div>
            {st.size ? (
              <div class="collage__bp"><Blueprint name={st.title} size={st.size} sync /></div>
            ) : (
              <div class="collage__info">
                <div class="collage__info-t">{st.title}</div>
                <p>{st.short}</p>
                <div class="tagrow">{st.tags.filter((t) => !t.startsWith('[')).map((t) => <span class="chip">{t}</span>)}</div>
              </div>
            )}
            <a class="collage__price" href={`/${st.slug}`}>
              <span>από</span><b>{st.priceFrom} €</b><span>/ βράδυ · {st.area} →</span>
            </a>
            {rs.length > 0 && (
              <div class="collage__review" data-rotate aria-live="off" aria-label={`Κριτικές για το ${st.title}`}>
                {rs.map((r, j) => (
                  <figure class="rq" data-on={j === 0 ? 'true' : 'false'} aria-hidden={j === 0 ? 'false' : 'true'}>
                    <div class="collage__score"><b>{r.score!.n}</b><span>/{r.score!.of} · {r.score!.src}<br />{r.score!.count}</span></div>
                    <blockquote>«{r.short}»</blockquote>
                    <figcaption>{r.name}, {r.home}</figcaption>
                  </figure>
                ))}
                {rs.length > 1 && <div class="rq__dots" aria-hidden="true">{rs.map((_, j) => <span data-on={j === 0 ? 'true' : 'false'}></span>)}</div>}
              </div>
            )}
          </div>
        );
      })}
      </div>
    </div>
    <BookingBox layout="bar" />
  </section>

  <section class="band band--gray">
    <div class="wrap grid why">
      <div><h3>Μιλάτε απευθείας μαζί μας</h3><p class="muted">Ό,τι χρειαστείτε, πριν και κατά τη διαμονή σας.</p></div>
      <div><h3>Άμεση επιβεβαίωση</h3><p class="muted">Ασφαλής online κράτηση με {site.paymentMethod}.</p></div>
      <div><h3>{site.directPerk.title}</h3><p class="muted">{site.directPerk.text}</p></div>
    </div>
  </section>

  <section class="block">
    <div class="wrap block__in">
      <h2 class="block__t">Πού πάμε;</h2>
      <div class="block__links">
        {stays.map((st) => <a href={`/${st.slug}`}><span>{st.place}</span><small>{st.title} · {st.area}</small></a>)}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="label">Κριτικές</div>
    <h2 style="margin: 8px 0 12px">Τι λένε οι επισκέπτες</h2>
    <p class="muted" style="margin-bottom: 32px">{ratings}</p>
    <ReviewCarousel />
  </section>

  <section id="guides" class="band band--honey">
    <div class="wrap">
      <div class="label" style="color: var(--pine-hover)">Οδηγοί περιοχής</div>
      <div class="more"><h2 class="head">Πριν έρθετε</h2><a href="/guides">Όλοι οι οδηγοί →</a></div>
      <div class="grid">
        {guides.slice(0, 3).map((g) => (
          <article class="guide"><div class="label">{g.tag}</div><h3 class="guide__t">{g.title}</h3></article>
        ))}
      </div>
    </div>
  </section>

  <section id="host" class="wrap section host">
    <div class="photo host__photo" role="img" aria-label="Θέση για φωτογραφία οικοδεσπότη">Φωτογραφία: εσύ</div>
    <div class="host__text">
      <div class="label">Ο οικοδεσπότης</div>
      <h2 style="margin: 8px 0 16px">Γεια, είμαι {site.host.name}</h2>
      <p style="max-width: 640px; margin-bottom: 12px">{site.host.bio}</p>
      <p class="small muted" style="margin-bottom: 16px">Μιλάω: {site.host.languages}</p>
      <a href="/host">Γνωρίστε μας →</a>
    </div>
  </section>
</Base>
<script>
  // Hero switch: the buttons swap the whole collage between the two homes,
  // highlight the matching word of the title and preselect the booking box.
  document.querySelectorAll<HTMLElement>('[data-hs]').forEach((hs) => {
    const tabs = [...hs.querySelectorAll<HTMLButtonElement>('[data-hs-tab]')];
    const show = (i: number) => {
      hs.dataset.active = String(i);
      document.querySelector<HTMLElement>('.hero__title')?.setAttribute('data-active', String(i));
      tabs.forEach((t, j) => t.setAttribute('aria-selected', String(i === j)));
      const sel = document.querySelector<HTMLSelectElement>('#book select[name=stay]');
      if (sel && tabs[i].dataset.slug) sel.value = tabs[i].dataset.slug!;
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const j = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        show(j); tabs[j].focus();
      });
    });
    show(0);
  });

  // The review card in the photo collage: next review every 5 seconds,
  // stays still while the mouse is over it (or it has keyboard focus).
  document.querySelectorAll<HTMLElement>('[data-rotate]').forEach((box) => {
    const items = [...box.querySelectorAll<HTMLElement>('.rq')];
    const dots = [...box.querySelectorAll<HTMLElement>('.rq__dots span')];
    if (items.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let cur = 0, hold = false;
    box.addEventListener('mouseenter', () => (hold = true));
    box.addEventListener('mouseleave', () => (hold = false));
    box.addEventListener('focusin', () => (hold = true));
    box.addEventListener('focusout', () => (hold = false));
    setInterval(() => {
      if (hold) return;
      cur = (cur + 1) % items.length;
      items.forEach((el, i) => { el.dataset.on = String(i === cur); el.setAttribute('aria-hidden', String(i !== cur)); });
      dots.forEach((d, i) => (d.dataset.on = String(i === cur)));
      document.dispatchEvent(new CustomEvent('collage:tick'));
    }, 5000);
  });
</script>
<style>
  .bighero { position: relative; min-height: min(88vh, 860px); display: flex; align-items: flex-end; color: var(--white); overflow: hidden; }
  .bighero__img { position: absolute; inset: 0; }
  .bighero__img :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
  .bighero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(31 28 26 / .05) 30%, rgb(31 28 26 / .72) 100%); }
  .bighero__text { position: relative; z-index: 1; width: 100%; padding-bottom: 72px; }
  .bighero .label { color: var(--white); }
  .bighero .label::before { color: var(--honey); }
  .bighero .hero__title { color: var(--white); text-shadow: 0 2px 30px rgb(0 0 0 / .25); }
  .bighero .hero__lead { color: rgb(255 255 255 / .9); }
  .bighero .hero__link { color: var(--white); }
  .bighero .hero__cta { margin-bottom: 0; }
  .apts__t { font-size: clamp(44px, 6vw, 88px); line-height: .95; letter-spacing: -0.04em; margin: 12px 0 36px; }
  .hero { padding-top: 96px; }
  .hero__title { font-weight: 600; font-size: clamp(56px, 10vw, 136px); line-height: .92; letter-spacing: -0.04em; margin: 14px 0 20px; }
  .hero__lead { max-width: 560px; font-size: 20px; color: var(--ink-2); }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin: 28px 0 48px; }
  .hero__link { color: var(--ink); font-weight: 500; }
  .hs { position: relative; }
  .hs__tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; position: relative; z-index: 4; }
  .hs__tab { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-height: 56px; padding: 10px 20px; border-radius: 6px; border: 1.5px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; font-family: var(--sans); text-align: left; transition: background .25s, color .25s; }
  .hs__tab:hover { background: rgb(54 48 43 / .06); }
  .hs__place { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; }
  .hs__name { font-size: 13px; opacity: .8; }
  .hs__tab--city[aria-selected='true'] { background: var(--honey) url('/paper.svg'); border-color: var(--honey); }
  .hs__tab--sea[aria-selected='true'] { background: var(--pine) url('/paper.svg'); border-color: var(--pine); color: var(--white); }
  /* Both homes sit on top of each other; the chosen one fades and slides in,
     piece by piece, while the other fades out. No jump in height. */
  .hs__stage { display: grid; }
  .hs [data-hs-panel] { grid-area: 1 / 1; opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity .7s ease, visibility 0s linear .7s; }
  .hs[data-active='0'] [data-hs-panel='0'], .hs[data-active='1'] [data-hs-panel='1'] { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity .7s ease, visibility 0s; }
  .hs [data-hs-panel] > * { transition: transform .9s cubic-bezier(.2,.7,.2,1), opacity .7s ease; opacity: 0; }
  .hs [data-hs-panel] > .collage__photo { transform: translateX(24px); }
  .hs [data-hs-panel] > .collage__bp, .hs [data-hs-panel] > .collage__info { transform: translateY(28px); }
  .hs [data-hs-panel] > .collage__price, .hs [data-hs-panel] > .collage__review { transform: translateY(36px); }
  .hs[data-active='0'] [data-hs-panel='0'] > *, .hs[data-active='1'] [data-hs-panel='1'] > * { opacity: 1; transform: none; }
  .hs[data-active='0'] [data-hs-panel='0'] > :nth-child(1), .hs[data-active='1'] [data-hs-panel='1'] > :nth-child(1) { transition-delay: 0s; }
  .hs[data-active='0'] [data-hs-panel='0'] > :nth-child(2), .hs[data-active='1'] [data-hs-panel='1'] > :nth-child(2) { transition-delay: .12s; }
  .hs[data-active='0'] [data-hs-panel='0'] > :nth-child(3), .hs[data-active='1'] [data-hs-panel='1'] > :nth-child(3) { transition-delay: .22s; }
  .hs[data-active='0'] [data-hs-panel='0'] > :nth-child(4), .hs[data-active='1'] [data-hs-panel='1'] > :nth-child(4) { transition-delay: .32s; }
  @media (prefers-reduced-motion: reduce) { .hs [data-hs-panel], .hs [data-hs-panel] > * { transition: none !important; transform: none !important; } }
  .hw { transition: color .3s, box-shadow .3s; }
  .hero__title[data-active='0'] .hw[data-word='0'] { box-shadow: inset 0 -.12em var(--honey); }
  .hero__title[data-active='1'] .hw[data-word='1'] { box-shadow: inset 0 -.12em var(--pine); }
  .collage { position: relative; height: 620px; }
  .collage__info { position: absolute; left: 0; top: 150px; width: 42%; z-index: 2; padding: 28px; border-radius: 6px; background: var(--pine) url('/paper.svg'); color: var(--white); box-shadow: 0 18px 40px rgb(36 94 64 / .25); display: flex; flex-direction: column; gap: 14px; }
  .collage__info-t { font-size: 32px; font-weight: 600; letter-spacing: -0.03em; }
  .collage__info .chip { background: rgb(255 255 255 / .16); color: var(--white); }
  .collage__price { position: absolute; left: calc(42% + 20px); bottom: 24px; z-index: 3; display: flex; flex-direction: column; padding: 16px 20px; border-radius: 6px; background: var(--honey) url('/paper.svg'); color: var(--ink); text-decoration: none; box-shadow: 0 18px 40px rgb(54 48 43 / .2); }
  .collage--sea .collage__price { background-color: var(--white); }
  .collage__price:hover { color: var(--ink); transform: translateY(-2px); }
  .collage__price span { font-size: 13px; }
  .collage__price span:first-child { text-transform: uppercase; letter-spacing: .06em; }
  .collage__price b { font-size: 36px; font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; }
  .collage__photo { position: absolute; right: 0; top: 0; width: 66%; height: 500px; }
  .collage__photo > :global(*) { height: 100%; }
  .collage__bp { position: absolute; left: 0; top: 150px; width: 42%; z-index: 2; box-shadow: 0 18px 40px rgb(36 94 64 / .25); }
  .collage__review { position: absolute; right: 6%; bottom: 0; width: 360px; padding: 22px 24px 16px; background: var(--white); border-radius: 6px; z-index: 3; box-shadow: 0 18px 40px rgb(54 48 43 / .18); display: grid; }
  .rq { grid-area: 1 / 1; margin: 0; opacity: 0; transform: translateY(10px); transition: opacity .8s ease, transform .9s cubic-bezier(.2,.7,.2,1); pointer-events: none; }
  .rq[data-on='true'] { opacity: 1; transform: none; pointer-events: auto; }
  .rq__dots { display: flex; gap: 6px; margin-top: 12px; }
  .rq__dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--line); transition: background .3s, width .3s; }
  .rq__dots span[data-on='true'] { background: var(--pine); width: 18px; border-radius: 3px; }
  @media (prefers-reduced-motion: reduce) { .rq { transition: none; } }
  .collage__score { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ink-2); line-height: 1.3; }
  .collage__score b { font-size: 40px; font-weight: 600; color: var(--ink); letter-spacing: -0.03em; }
  .collage__review blockquote { margin: 12px 0 8px; font-size: 18px; line-height: 1.35; }
  .collage__review figcaption { font-size: 13px; color: var(--ink-2); }
  .collage__eagle { position: absolute; left: 4%; top: 64px; width: 150px; z-index: 1; }
  .hero :global(.book--bar) { margin-top: 40px; margin-left: 0; margin-right: 0; }
  .big { font-size: clamp(44px, 6vw, 80px); }
  .big sup { font-size: .3em; font-weight: 500; vertical-align: top; margin-left: 4px; color: var(--ink-2); }
  .block { margin-top: var(--section); background: var(--honey) url('/paper.svg'); }
  .block__in { padding-top: 96px; padding-bottom: 96px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px; }
  .block__t { font-size: clamp(56px, 9vw, 128px); line-height: .9; letter-spacing: -0.04em; }
  .block__links { display: flex; flex-direction: column; gap: 18px; }
  .block__links a { display: flex; flex-direction: column; color: var(--ink); text-decoration: none; }
  .block__links span { font-size: 40px; font-weight: 600; letter-spacing: -0.03em; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .block__links span::after { content: ' →'; }
  .block__links small { font-size: 15px; margin-top: 6px; }
  .block__links a:hover span { color: var(--white); }
  @media (max-width: 900px) {
    .collage { height: auto; display: flex; flex-direction: column; gap: 16px; }
    .collage__photo, .collage__bp, .collage__review, .collage__info, .collage__price { position: static; width: 100%; }
    .collage__photo { height: 320px; }
    .collage__eagle { display: none; }
  }
  .stays { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .why h3 { font-size: 24px; margin-bottom: 8px; }
  .review { margin: 0; padding: 28px; background: var(--white); border: 1px solid var(--line); border-radius: 6px; }
  .review__stars { color: var(--coral); letter-spacing: 2px; }
  .review blockquote { margin: 12px 0; font-size: 19px; line-height: 1.4; }
  .more { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; }
  .guide { padding: 24px; background: var(--white); border-radius: 6px; }
  .guide__t { font-size: 22px; font-weight: 500; margin-top: 8px; }
  .host { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .host__photo { flex: 0 0 320px; height: 320px; }
  .host__text { flex: 999 1 420px; min-width: 0; }
  @media (max-width: 700px) {
    .hero { padding-top: 56px; }
    .bighero { min-height: 78vh; }
    .bighero__text { padding-bottom: 40px; }
    .host__photo { flex-basis: 100%; height: 260px; }
  }
</style>
