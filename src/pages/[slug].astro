---
// One page per apartment: /thessaloniki, /chalkidiki (from src/data/stays.ts).
import Base from '../layouts/Base.astro';
import BookingBox from '../components/BookingBox.astro';
import Photo from '../components/Photo.astro';
import Blueprint from '../components/Blueprint.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { site } from '../data/site';
import { stays, type Stay } from '../data/stays';

export function getStaticPaths() {
  return stays.map((stay) => ({ params: { slug: stay.slug }, props: { stay } }));
}
const { stay: s } = Astro.props as { stay: Stay };
const other = stays.find((o) => o.slug !== s.slug);
const [big, ...rest] = s.photos;
const small = rest.slice(0, 4);
const real = s.photos.filter((p) => p.name);
const w = (n: string, one: string, many: string) => `${n} ${n === '1' ? one : many}`;
const facts = [w(s.facts.guests, 'άτομο', 'άτομα'), w(s.facts.bedrooms, 'υπνοδωμάτιο', 'υπνοδωμάτια'), w(s.facts.beds, 'κρεβάτι', 'κρεβάτια'), w(s.facts.baths, 'μπάνιο', 'μπάνια')];
if (s.size) facts.push(`${s.size} τ.μ.`);
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<Base title={`${s.title} · ${site.name}`} description={s.short} theme={s.theme}>
  <section class="wrap" style="padding-top: 40px">
    <a href="/" class="small" style="display: block; width: max-content">← Όλα τα σπίτια</a>
    <div class="label" style="margin-top: 28px">{s.place} · {s.area}</div>
    <h1 class="title">{s.heroTitle}{s.isNew && <sup class="title__new">Νέο</sup>}</h1>
    <div class="tagrow">{facts.map((f) => <span class="chip">{f}</span>)}</div>

    <div class="gallery">
      <div class="gallery__big"><Photo name={big.name} alt={big.alt} eager sizes="(max-width: 700px) 100vw, 640px" /></div>
      {small.map((p) => <div class="gallery__cell"><Photo name={p.name} alt={p.alt} sizes="(max-width: 700px) 50vw, 320px" /></div>)}
      {real.length > 1 && <button type="button" class="btn btn--ghost gallery__all" data-open="all-photos">Όλες οι φωτογραφίες ({real.length})</button>}
      <a href="#book" class:list={['pricecard', `pricecard--${s.theme}`]}>
        <span class="pricecard__from">από</span>
        <span class="pricecard__n">{s.priceFrom} €</span>
        <span class="pricecard__per">/ βράδυ · Κράτηση →</span>
      </a>
      {s.rating && (
        <div class="scorecard"><b>{s.rating.score}</b><span>/10 · {s.rating.source}<br />{s.rating.count}</span></div>
      )}
    </div>
    {real.length > 1 && (
      <dialog id="all-photos" class="all" aria-label="Όλες οι φωτογραφίες">
        <form method="dialog"><button class="btn all__close">Κλείσιμο ✕</button></form>
        <div class="all__grid">{real.map((p) => <figure><Photo name={p.name} alt={p.alt} sizes="(max-width: 700px) 100vw, 600px" /><figcaption class="small">{p.alt}</figcaption></figure>)}</div>
      </dialog>
    )}
  </section>

  <section class="wrap split" style="padding-top: 72px">
    <div class="main">
      <div class="label">Το διαμέρισμα</div>
      <p class="lead">{s.description}</p>
      <div class="tagrow" style="margin-top: 20px">{s.tags.map((t) => <span class="chip chip--tag">{t}</span>)}</div>
      {s.size && <div class="bpwrap"><Blueprint name={s.title} size={s.size} /></div>}

      <div class="block">
        <div class="block__head"><h2>Τι προσφέρει</h2><span class="num">({String(s.amenities.length).padStart(2, '0')})</span></div>
        <ul class="amen">{s.amenities.map((a) => <li class="tick">{a}</li>)}</ul>
      </div>

      <div class="block">
        <div class="block__head"><h2>Κανόνες</h2><span class="num">({String(s.rules.length + 1).padStart(2, '0')})</span></div>
        <table class="spec">
          <tbody>
            {s.rules.map((r, i) => <tr><td class="num">{pad(i)}</td><th scope="row">{r.label}</th><td>{r.value}</td></tr>)}
            <tr><td class="num">{pad(s.rules.length)}</td><th scope="row">ΑΜΑ</th><td>{s.ama}</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <aside class="side"><BookingBox stay={s} /></aside>
  </section>

  <section class="wrap section">
    <div class="label">Τοποθεσία</div>
    <h2 class="head" style="font-size: clamp(40px, 5vw, 64px)">Πού θα μείνετε</h2>
    <div class="split" style="gap: 40px">
      <div class:list={['mapph', 'main', `mapph--${s.theme}`]} role="img" aria-label={`Θέση για χάρτη: ${s.area}, ${s.place}`}>
        <span class="mapph__tag">/Χάρτης</span>
        <span class="mapph__pin"></span>
        <span class="mapph__name">{s.area}</span>
      </div>
      <table class="side spec near">
        <tbody>{s.nearby.map((n, i) => <tr><td class="num">{pad(i)}</td><th scope="row">{n.name}</th><td class="near__d">{n.time}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <CtaBlock title="Κλείστε απευθείας." tone={s.theme === 'sea' ? 'pine' : 'honey'}>
    <a href="#book"><span>Ημερομηνίες</span><small>Δείτε διαθεσιμότητα για το {s.title}</small></a>
    {other && <a href={`/${other.slug}`}><span>{other.place}</span><small>Το άλλο μας σπίτι · {other.title}</small></a>}
  </CtaBlock>
</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById(b.dataset.open!) as HTMLDialogElement)?.showModal()));
</script>
<style>
  .title { font-weight: 600; font-size: clamp(52px, 8vw, 120px); line-height: .92; letter-spacing: -0.04em; margin: 14px 0 22px; }
  .title__new { font-size: 15px; letter-spacing: 0; font-weight: 600; vertical-align: top; margin-left: 10px; padding: 3px 10px; border-radius: 6px; background: var(--coral); color: var(--white); position: relative; top: 14px; }
  .gallery { position: relative; margin-top: 36px; display: grid; gap: 12px; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: 250px 250px; }
  .gallery > div { min-height: 0; }
  .gallery > div > :global(*) { height: 100%; }
  .gallery__big { grid-column: span 2; grid-row: span 2; }
  .gallery__all { position: absolute; right: 12px; bottom: 12px; min-height: 44px; font-size: 15px; border-color: transparent; }
  .pricecard { position: absolute; left: 24px; bottom: -36px; display: flex; flex-direction: column; padding: 18px 22px; border-radius: 6px; text-decoration: none; color: var(--ink); background: var(--honey) url('/paper.svg'); box-shadow: 0 18px 40px rgb(54 48 43 / .22); }
  .pricecard--sea { background-color: var(--pine); color: var(--white); }
  .pricecard:hover { color: inherit; transform: translateY(-2px); }
  .pricecard__from { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; }
  .pricecard__n { font-size: 44px; font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  .pricecard__per { font-size: 14px; margin-top: 4px; }
  .scorecard { position: absolute; left: calc(50% - 150px); top: 24px; display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-radius: 6px; background: var(--white); box-shadow: 0 18px 40px rgb(54 48 43 / .18); font-size: 13px; color: var(--ink-2); line-height: 1.3; }
  .scorecard b { font-size: 36px; font-weight: 600; color: var(--ink); letter-spacing: -0.03em; }
  .all { width: min(1100px, 94vw); max-height: 90vh; border: 0; border-radius: 6px; padding: 24px; background: var(--bg); }
  .all::backdrop { background: rgb(52 54 58 / .8); }
  .all form { display: flex; justify-content: flex-end; margin-bottom: 16px; }
  .all__grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .all figure { margin: 0; }
  .all figure :global(img) { height: auto; }
  .all figcaption { margin-top: 6px; color: var(--ink-2); }
  .lead { font-size: clamp(20px, 2vw, 24px); line-height: 1.45; letter-spacing: -0.01em; margin-top: 14px; }
  .chip--tag { background: var(--white); border: 1px solid var(--line); }
  .bpwrap { margin-top: 40px; max-width: 560px; }
  .block { margin-top: 64px; padding-top: 28px; border-top: 1.5px solid var(--ink); }
  .block__head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; }
  .block__head h2 { font-size: 36px; }
  .amen { margin: 0; padding: 0; list-style: none; display: grid; gap: 14px 32px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .spec { width: 100%; border-collapse: collapse; }
  .spec tr { border-bottom: 1px solid var(--line); }
  .spec td, .spec th { padding: 14px 0; text-align: left; vertical-align: top; }
  .spec th { font-weight: 500; padding-right: 16px; }
  .spec td.num { width: 48px; padding-top: 16px; }
  .spec td:last-child { text-align: right; }
  .near__d { font-weight: 600; white-space: nowrap; }
  .mapph { position: relative; height: 420px; border-radius: 6px; overflow: hidden; background: var(--gray-light) url('/paper.svg'); background-image: url('/paper.svg'), linear-gradient(rgb(54 48 43 / .08) 1px, transparent 1px), linear-gradient(90deg, rgb(54 48 43 / .08) 1px, transparent 1px); background-size: auto, 40px 40px, 40px 40px; }
  .mapph__tag { position: absolute; left: 20px; top: 16px; font-size: 14px; }
  .mapph__pin { position: absolute; left: 50%; top: 50%; width: 26px; height: 26px; margin: -13px; border-radius: 50%; background: var(--honey); border: 3px solid var(--ink); }
  .mapph--sea .mapph__pin { border-radius: 50% 50% 50% 0; background: var(--coral); }
  .mapph__name { position: absolute; left: calc(50% + 24px); top: calc(50% - 12px); font-weight: 600; }
  @media (max-width: 760px) {
    .gallery { grid-template-columns: 1fr 1fr; grid-template-rows: 240px 140px 140px; }
    .gallery__big { grid-row: span 1; }
    .scorecard { left: 12px; top: 12px; }
    .pricecard { position: static; margin-top: 4px; grid-column: 1 / -1; }
    .gallery__all { bottom: auto; top: 200px; }
    .mapph { height: 300px; }
  }
</style>
