---
// One page per apartment: /thessaloniki, /chalkidiki (from src/data/stays.ts).
import Base from '../layouts/Base.astro';
import BookingBox from '../components/BookingBox.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import { stays, factsLine, type Stay } from '../data/stays';

export function getStaticPaths() {
  return stays.map((stay) => ({ params: { slug: stay.slug }, props: { stay } }));
}
const { stay: s } = Astro.props as { stay: Stay };
const other = stays.find((o) => o.slug !== s.slug);
const [big, ...rest] = s.photos;
const small = rest.slice(0, 4);
const real = s.photos.filter((p) => p.name);
---
<Base title={`${s.title} · ${site.name}`} description={s.short} theme={s.theme}>
  <section class="wrap" style="padding-top: 40px">
    <a href="/" class="small">← Όλα τα καταλύματα</a>
    <div class="label" style="margin-top: 24px">{s.place} · {s.area}</div>
    <h1 class:list={['title', s.theme === 'sea' && 'title--sea']}>{s.heroTitle}</h1>
    <div class="facts small muted">
      <span>{factsLine(s.facts)}</span>
      {s.isNew && <span class="chip chip--new">Νέο</span>}
    </div>
    <div class="gallery">
      <div class="gallery__big" data-lb={big.name ? real.indexOf(big) : undefined}><Photo name={big.name} alt={big.alt} eager sizes="(max-width: 700px) 100vw, 640px" /></div>
      {small.map((p) => <div class="gallery__cell" data-lb={p.name ? real.indexOf(p) : undefined}><Photo name={p.name} alt={p.alt} sizes="(max-width: 700px) 50vw, 320px" /></div>)}
      {real.length > 1 && <button type="button" class="btn btn--ghost gallery__all" data-open="all-photos">Όλες οι φωτογραφίες ({real.length})</button>}
    </div>
    {real.length > 1 && (
      <dialog id="all-photos" class="all" aria-label="Όλες οι φωτογραφίες">
        <form method="dialog"><button class="btn all__close">Κλείσιμο ✕</button></form>
        <div class="all__grid">{real.map((p, i) => <figure data-lb={i}><Photo name={p.name} alt={p.alt} sizes="(max-width: 700px) 100vw, 600px" /><figcaption class="small">{p.alt}</figcaption></figure>)}</div>
      </dialog>
    )}
    {real.length > 0 && (
      <dialog id="lightbox" class="lb" aria-label="Φωτογραφία">
        <img class="lb__img" alt="" />
        <form method="dialog"><button class="lb__btn lb__close" aria-label="Κλείσιμο">✕</button></form>
        <button type="button" class="lb__btn lb__prev" aria-label="Προηγούμενη φωτογραφία">←</button>
        <button type="button" class="lb__btn lb__next" aria-label="Επόμενη φωτογραφία">→</button>
        <p class="lb__cap"><span class="lb__n"></span><span class="lb__t"></span></p>
      </dialog>
    )}
  </section>

  <section class="wrap split" style="padding-top: 56px">
    <div class="main">
      <h2 class="sub">Το διαμέρισμα</h2>
      <p>{s.description}</p>
      <div class="tags">{s.tags.map((t) => <span class="chip">{t}</span>)}</div>

      <div class="block">
        <h2 class="sub">Τι προσφέρει</h2>
        <ul class="list">{s.amenities.map((a) => <li>{a}</li>)}</ul>
      </div>

      <div class="block">
        <h2 class="sub">Κανόνες</h2>
        <dl class="list">
          {s.rules.map((r) => <div><dt class="small muted">{r.label}</dt><dd>{r.value}</dd></div>)}
          <div><dt class="small muted">ΑΜΑ</dt><dd>{s.ama}</dd></div>
        </dl>
      </div>
    </div>
    <aside class="side"><BookingBox stay={s} /></aside>
  </section>

  <section class:list={[s.theme === 'sea' ? 'band band--pine' : 'section']}>
    <div class="wrap">
      <div class="label">Τοποθεσία</div>
      <h2 class="head">Πού θα μείνετε</h2>
      <div class="split" style="gap: 40px">
        <div class="photo main" style="height: 400px" role="img" aria-label="Θέση για χάρτη">Χάρτης: {s.area}, {s.mapQuery}</div>
        <ul class="side near">{s.nearby.map((n) => <li><span>{n.name}</span><span>{n.time}</span></li>)}</ul>
      </div>
    </div>
  </section>

  {other && (
    <section class="wrap section">
      <h2 class="sub">Δείτε και το άλλο μας διαμέρισμα</h2>
      <a href={`/${other.slug}`} class:list={['other', `other--${other.theme}`]}>
        <div class="other__photo"><Photo name={other.cardPhoto} alt={`Φωτογραφία: ${other.place}`} sizes="(max-width: 700px) 100vw, 420px" /></div>
        <div class="other__body">
          <div class="label">{other.place} · {other.area}</div>
          <div class="other__t">{other.title}</div>
          <div>από <strong>{other.priceFrom} €</strong> / βράδυ →</div>
        </div>
      </a>
    </section>
  )}
</Base>
<script>
  // Lightbox: every photo (page gallery or the "all photos" grid) opens on its own,
  // with arrows, keyboard (← →, Esc) and swipe.
  const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (lb) {
    const pics = [...document.querySelectorAll<HTMLImageElement>('.all__grid img')];
    const img = lb.querySelector<HTMLImageElement>('.lb__img')!;
    let at = 0;
    const show = (i: number) => {
      at = (i + pics.length) % pics.length;
      img.src = pics[at].getAttribute('src')!; img.alt = pics[at].alt;
      lb.querySelector('.lb__n')!.textContent = `${at + 1} / ${pics.length}`;
      lb.querySelector('.lb__t')!.textContent = pics[at].alt;
    };
    document.querySelectorAll<HTMLElement>('[data-lb]').forEach((el) => {
      el.style.cursor = 'zoom-in';
      el.addEventListener('click', () => { show(+el.dataset.lb!); if (!lb.open) lb.showModal(); });
    });
    lb.querySelector('.lb__prev')!.addEventListener('click', () => show(at - 1));
    lb.querySelector('.lb__next')!.addEventListener('click', () => show(at + 1));
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    let x0 = 0;
    lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => { const d = e.changedTouches[0].clientX - x0; if (Math.abs(d) > 40) show(at + (d < 0 ? 1 : -1)); });
    if (pics.length < 2) lb.querySelectorAll<HTMLElement>('.lb__prev, .lb__next').forEach((b) => (b.hidden = true));
  }
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById(b.dataset.open!) as HTMLDialogElement)?.showModal()));
</script>
<style>
  .title { font-weight: 700; font-size: clamp(38px, 5vw, 56px); margin: 8px 0; }
  .title--sea { font-style: italic; font-weight: 500; font-size: clamp(48px, 7vw, 96px); line-height: 1.05; }
  .facts { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  .gallery { margin-top: 32px; display: grid; gap: 12px; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: 240px 240px; }
  .gallery { position: relative; }
  .gallery > div { min-height: 0; }
  .gallery > div > :global(*) { height: 100%; }
  .gallery__big { grid-column: span 2; grid-row: span 2; }
  .gallery__all { position: absolute; right: 12px; bottom: 12px; min-height: 44px; font-size: 15px; }
  .all { width: min(1100px, 94vw); max-height: 90vh; border: 0; border-radius: var(--radius); padding: 24px; background: var(--bg); }
  .all::backdrop { background: rgb(52 54 58 / .8); }
  .all form { display: flex; justify-content: flex-end; margin-bottom: 16px; }
  .all__grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .all figure { margin: 0; }
  .all figure :global(img) { height: auto; aspect-ratio: auto; }
  .lb { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 56px 80px 64px; border: 0; background: rgb(28 25 22 / .98); color: #fff; }
  .lb[open] { display: grid; place-items: center; }
  .lb::backdrop { background: transparent; }
  .lb__img { max-width: 100%; max-height: calc(100vh - 120px); width: auto; height: auto; object-fit: contain; border-radius: 4px; }
  .lb form { position: absolute; top: 14px; right: 14px; margin: 0; }
  .lb__btn { width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgb(255 255 255 / .35); background: rgb(255 255 255 / .08); color: #fff; font-size: 20px; cursor: pointer; transition: background .2s; }
  .lb__btn:hover { background: rgb(255 255 255 / .2); }
  .lb__prev, .lb__next { position: absolute; top: 50%; translate: 0 -50%; }
  .lb__prev { left: 16px; } .lb__next { right: 16px; }
  .lb__cap { position: absolute; left: 0; right: 0; bottom: 18px; margin: 0; text-align: center; font-size: 15px; color: rgb(255 255 255 / .85); }
  .lb__n { margin-right: 12px; color: var(--honey); font-variant-numeric: tabular-nums; }
  .all figure { cursor: zoom-in; }
  @media (max-width: 700px) {
    .lb { padding: 64px 8px 72px; }
    .lb__prev, .lb__next { top: auto; bottom: 10px; translate: none; }
    .lb__cap { bottom: 72px; padding: 0 16px; }
  }
  .all figcaption { margin-top: 6px; color: var(--ink-2); }
  [data-theme='city'] .gallery .photo, [data-theme='city'] .photo { border-radius: 0; }
  .sub { font-size: 30px; margin-bottom: 16px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .block { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--line); }
  .list { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px 32px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .list dd { margin: 0; }
  .near { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .near li { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .other { display: flex; flex-wrap: wrap; border-radius: 6px; overflow: hidden; color: var(--ink); text-decoration: none; border: 1px solid var(--line); background: var(--honey-light); }
  .other--sea { background: var(--pine-light); }
  .other:hover { color: var(--ink); border-color: var(--gray-warm); }
  .other__photo { flex: 1 1 320px; height: 260px; }
  .other__photo > :global(*) { height: 100%; border-radius: 0; }
  .other__body { flex: 999 1 360px; padding: 32px; display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .other__t { font: 500 28px var(--serif); }
  @media (max-width: 700px) {
    .gallery { grid-template-columns: 1fr 1fr; grid-template-rows: 220px 140px 140px; }
    .gallery__big { grid-row: span 1; }
  }
</style>
