---
// The frame every page sits in: <head>, fonts, menu and footer.
import '@fontsource/inter-tight/400.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/inter-tight/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  theme?: 'city' | 'sea'; // look of an apartment page
}
const { title, description = site.description, theme } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/', site.url).href;
---
<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F7F5F0" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body data-theme={theme}>
    <script is:inline define:vars={{ real: site.name }}>
      // Name test: /?brand=Folia shows the whole site under another name (this tab only).
      try {
        const q = new URLSearchParams(location.search);
        if (q.has('brand')) { const b = q.get('brand'); b ? sessionStorage.setItem('brand', b) : sessionStorage.removeItem('brand'); }
        const b = sessionStorage.getItem('brand');
        if (b) {
          const swap = () => { document.querySelectorAll('[data-brand]').forEach((el) => (el.textContent = b)); document.title = document.title.split(real).join(b); };
          document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', swap) : swap();
        }
      } catch (e) {}
    </script>
    <a class="skip-link" href="#main">Μετάβαση στο περιεχόμενο</a>
    <Header theme={theme} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
